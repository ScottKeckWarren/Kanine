{
    "name": "scottkeckwarren/kanine",
    "description": "Kanine PHP application",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "symfony/console": "^7.0",
        "symfony/yaml": "^7.0",
        "php-tui/php-tui": "^0.1",
        "monolog/monolog": "^3.10",
        "react/http": "^1.11",
        "guzzlehttp/guzzle": "^7.0",
        "symfony/process": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.10",
        "slevomat/coding-standard": "^8.15",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "ScottKeckWarren\\Kanine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ScottKeckWarren\\Kanine\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/kanine"
    ],
    "scripts": {
        "test": [
            "./vendor/bin/phpunit",
            "./tests/hooks/normalize-script-paths-test.sh"
        ],
        "test-hooks": "./tests/hooks/normalize-script-paths-test.sh",
        "lint": "./vendor/bin/phpcs"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
