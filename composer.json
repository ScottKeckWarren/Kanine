{
    "name": "scottkeckwarren/kanine",
    "description": "Kanine PHP application",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "symfony/console": "^7.0",
        "symfony/yaml": "^7.0",
        "php-tui/php-tui": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "ScottKeckWarren\\Kanine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ScottKeckWarren\\Kanine\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/kanine"
    ],
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "lint": "./vendor/bin/phpcs"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
